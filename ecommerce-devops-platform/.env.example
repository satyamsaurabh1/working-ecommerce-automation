# Copy to .env with:  pwsh ./scripts/init-env.ps1
# init-env.ps1 replaces every CHANGE_ME with a fresh random secret.
# .env is git-ignored. NEVER commit real values.

# --- Application image (deploy.ps1 / rollback.ps1 update APP_IMAGE_TAG) ---
APP_IMAGE=ecommerce-api
APP_IMAGE_TAG=local
LOG_LEVEL=info
CORS_ORIGINS=https://localhost

# --- MongoDB (three users: root for ops, app for the API, backup for dumps) ---
MONGO_APP_DATABASE=ecommerce
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_APP_USERNAME=ecommerce_app
MONGO_APP_PASSWORD=CHANGE_ME
MONGO_BACKUP_USERNAME=ecommerce_backup
MONGO_BACKUP_PASSWORD=CHANGE_ME

# --- API security ---
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- Published ports (change if 80/443 are already in use) ---
HTTP_PORT=80
HTTPS_PORT=443
